# Copy to .env to override docker-compose defaults. Never commit .env.
POSTGRES_PASSWORD=postgres
JWT_SECRET=dev-only-change-me-please-32-chars-min
INTERNAL_TOKEN=dev-internal-token
DEMO_PASSWORD=skybook
RATE_LIMIT_PER_MINUTE=6000
LOG_LEVEL=info

# Seed size (use 1000000 for benchmarks; 20000 starts in seconds)
SEED_FLIGHTS=20000

# Behaviour knobs
SEARCH_CACHE_ENABLED=true
# or optimistic
INVENTORY_LOCK_STRATEGY=pessimistic
SEAT_HOLD_TTL_SECONDS=600
# tok_success / tok_fail ignore this
PAYMENT_FAILURE_RATE=0.1
PAYMENT_DELAY_MS=200
NOTIFICATION_FAILURE_RATE=0
# production: 60000,300000,1800000
NOTIFICATION_RETRY_DELAYS_MS=5000,10000,15000
