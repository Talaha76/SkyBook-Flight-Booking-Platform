{
  "name": "skybook",
  "version": "1.0.0",
  "private": true,
  "description": "SkyBook - flight booking microservices (Node.js, TypeScript, Kafka, PostgreSQL, Redis)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:gateway": "node dist/services/gateway/src/index.js",
    "start:flight-search": "node dist/services/flight-search/src/index.js",
    "start:booking": "node dist/services/booking/src/index.js",
    "start:inventory": "node dist/services/inventory/src/index.js",
    "start:payment": "node dist/services/payment/src/index.js",
    "start:notification": "node dist/services/notification/src/index.js",
    "seed": "node dist/scripts/seed-flights.js",
    "e2e": "node dist/scripts/e2e.js",
    "dlq:replay": "node dist/scripts/dlq-replay.js",
    "bench:explain": "node dist/scripts/explain-benchmark.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
